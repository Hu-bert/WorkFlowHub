{
  "ConnectionStrings": {
    "FlowHub": "Data Source=flowhub.db"
  },
  "Workspace": {
    "Root": "../..",
    "WorkDirectory": ""
  },
  "Board": {
    "Columns": [
      { "Key": "todo", "Label": "Do zrobienia", "Icon": "mdi-tray-full" },
      { "Key": "in-progress", "Label": "W pracy", "Icon": "mdi-progress-wrench" },
      { "Key": "waiting", "Label": "Czeka", "Icon": "mdi-timer-sand" },
      { "Key": "waiting-tests", "Label": "Czeka na testy", "Icon": "mdi-test-tube" },
      { "Key": "waiting-deploy", "Label": "Czeka na wdrożenie", "Icon": "mdi-rocket-launch-outline" },
      { "Key": "done", "Label": "Gotowe", "Icon": "mdi-check-circle-outline" }
    ]
  },
  "Agent": {
    "Runner": "Fake",
    "CliPath": "copilot",
    "FakeDelayMs": 25
  },
  "Models": {
    "DefaultTier": "cheap",
    "TaskTokenBudget": 2000000,
    "Tiers": {
      "cheap": "gpt-5-mini",
      "standard": "claude-sonnet-4.5",
      "premium": "claude-opus-4.5"
    },
    "Prices": {
      "gpt-5-mini": { "InputPerMillion": 0.25, "OutputPerMillion": 2.0, "CacheReadPerMillion": 0.025 },
      "claude-sonnet-4.5": { "InputPerMillion": 3.0, "OutputPerMillion": 15.0, "CacheReadPerMillion": 0.3, "CacheWritePerMillion": 3.75 },
      "claude-opus-4.5": { "InputPerMillion": 5.0, "OutputPerMillion": 25.0, "CacheReadPerMillion": 0.5, "CacheWritePerMillion": 6.25 }
    }
  },
  "Integrations": {
    "TaskSource": "Fake",
    "PullRequests": "Fake",
    "Ci": "Fake",
    "Deploy": "Fake",
    "Docs": "Fake"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/flowhub-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  },
  "AllowedHosts": "*"
}
