{
  "ConnectionStrings": {
    "FlowHub": "Data Source=flowhub.db"
  },
  "Integrations": {
    "TaskSource": "Fake",
    "PullRequests": "Fake",
    "Ci": "Fake",
    "Deploy": "Fake",
    "Docs": "Fake",
    "AgentRunner": "Fake"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/flowhub-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  },
  "AllowedHosts": "*"
}
