{
  "ConnectionStrings": {
    "FlowHub": "Data Source=flowhub.db"
  },
  "Workspace": {
    "Root": "../..",
    "WorkDirectory": ""
  },
  "Board": {
    "Columns": [
      { "Key": "todo", "Label": "Do zrobienia", "Icon": "mdi-tray-full" },
      { "Key": "in-progress", "Label": "W pracy", "Icon": "mdi-progress-wrench" },
      { "Key": "waiting", "Label": "Czeka", "Icon": "mdi-timer-sand" },
      { "Key": "waiting-tests", "Label": "Czeka na testy", "Icon": "mdi-test-tube" },
      { "Key": "waiting-deploy", "Label": "Czeka na wdrożenie", "Icon": "mdi-rocket-launch-outline" },
      { "Key": "done", "Label": "Gotowe", "Icon": "mdi-check-circle-outline" }
    ]
  },
  "Agent": {
    "Runner": "Fake",
    "CliPath": "copilot",
    "FakeDelayMs": 25
  },
  "Models": {
    "Plan": "Metered",
    "DefaultTier": "cheap",
    "TaskTokenBudget": 2000000,
    "Tiers": {
      "cheap": "auto",
      "standard": "auto",
      "premium": "auto"
    },
    "Prices": {}
  },
  "Integrations": {
    "TaskSource": "Fake",
    "PullRequests": "Fake",
    "RepositoryDirectory": "Fake",
    "Ci": "Fake",
    "Deploy": "Fake"
  },
  "Tfs": {
    "CollectionUrl": "",
    "Project": "",
    "ApiVersion": "6.0"
  },
  "Jira": {
    "BaseUrl": "",
    "Email": ""
  },
  "TeamCity": {
    "BaseUrl": ""
  },
  "Octopus": {
    "BaseUrl": ""
  },
  "RepoStatus": {
    "RefreshSeconds": 120,
    "ReadyEnvironment": "DEV"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/flowhub-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 } }
    ]
  },
  "AllowedHosts": "*"
}
